# /etc/flexdrop/flexdrop.env  (chmod 600, owned by root; values from your secret manager)
FLEXDROP_ENV=production
FLEXDROP_DATABASE_URL=postgresql+psycopg://flexdrop:CHANGE_ME@db.internal:5432/flexdrop
FLEXDROP_PSEUDONYMIZATION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# one entry per calling system, generated with `flexdrop create-api-key`
FLEXDROP_API_KEYS={"<sha256-of-checkout-key>": {"name": "checkout-svc", "roles": ["checkout"]}, "<sha256-of-dispatch-key>": {"name": "dispatch-svc", "roles": ["dispatch"]}}
FLEXDROP_MODEL_DIR=/opt/flexdrop/models
FLEXDROP_DEPLOYMENT_LEVEL=1
FLEXDROP_SOLVER=cpsat
FLEXDROP_CPSAT_TIME_LIMIT_S=2.0
FLEXDROP_RATE_LIMIT_PER_MINUTE=1200
FLEXDROP_LOG_LEVEL=INFO
FLEXDROP_LOG_JSON=true
FLEXDROP_DATA_RETENTION_DAYS=90
