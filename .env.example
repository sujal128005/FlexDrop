# Local development settings (copy to .env). Never commit real keys or secrets.
FLEXDROP_ENV=development
FLEXDROP_DATABASE_URL=sqlite:///./flexdrop.db
FLEXDROP_MODEL_DIR=models
FLEXDROP_DEPLOYMENT_LEVEL=1
# Paste the JSON line printed by `flexdrop create-api-key --name local-admin --roles admin`
FLEXDROP_API_KEYS={}
FLEXDROP_PSEUDONYMIZATION_SECRET=dev-only-pseudonymization-secret-change-me
FLEXDROP_LOG_JSON=false
FLEXDROP_LOG_LEVEL=INFO
